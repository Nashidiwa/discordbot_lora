# Environment Mode
NODE_ENV=production
LOG_LEVEL=info

# Discord Application Credentials (Required)
DISCORD_TOKEN=
DISCORD_CLIENT_SECRET=
CLIENT_ID=
DEV_GUILD_ID=

# Database Configuration (SQLite with WAL & busy timeout)
# - Local Dev: "file:./dev.db?connection_limit=1&busy_timeout=5000"
# - Docker / VPS: "file:/app/data/lora.db?connection_limit=1&busy_timeout=5000"
DATABASE_URL="file:/app/data/lora.db?connection_limit=1&busy_timeout=5000"

# Web Server (Fastify)
PORT=3000

# OAuth2 Redirect URI (Must match Discord Developer Portal)
# - Local Dev: "http://localhost:3000/auth/discord/callback"
# - Production: "https://yourdomain.com/auth/discord/callback"
DISCORD_REDIRECT_URI="http://localhost:3000/auth/discord/callback"

# Optional: prioritize identifying owner (Discord User ID)
BOT_OWNER_ID=
