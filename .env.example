# Environment Mode
NODE_ENV=production
LOG_LEVEL=info

# Discord Application Credentials (Required)
DISCORD_TOKEN=
DISCORD_CLIENT_SECRET=
CLIENT_ID=
DEV_GUILD_ID=

# Database Configuration (SQLite with WAL & busy timeout)
# - Local Dev: "file:./dev.db?connection_limit=1&busy_timeout=5000"
# - Docker / VPS: "file:/app/data/lora.db?connection_limit=1&busy_timeout=5000"
DATABASE_URL="file:/app/data/lora.db?connection_limit=1&busy_timeout=5000"

# Web Server (Fastify)
PORT=3000

# OAuth2 Redirect URIs (Must match Discord Developer Portal -> OAuth2 -> Redirects)
# 1. Swarm Linked Roles callback:
# - Local Dev: "http://localhost:3000/auth/discord/callback"
# - Production: "https://yourdomain.com/auth/discord/callback"
DISCORD_REDIRECT_URI="http://localhost:3000/auth/discord/callback"

# 2. Web Dashboard login callback:
# - Local Dev: "http://localhost:3000/api/auth/discord/callback"
# - Production: "https://yourdomain.com/api/auth/discord/callback"
DISCORD_DASHBOARD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# Security & Dashboard Access (Optional)
# - Prioritize identifying Bot Owner by Discord User ID
BOT_OWNER_ID=
# - Master API Key for headless automation / direct API calls without OAuth2 cookie
MASTER_API_KEY=
# - Secret for HMAC session cookies (fallback: DISCORD_CLIENT_SECRET)
COOKIE_SECRET=
# - Additional CORS origins (comma-separated, default: localhost:5173, localhost:3000)
ALLOWED_ORIGINS=
