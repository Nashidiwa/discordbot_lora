{
  "name": "discordbot_lora",
  "version": "0.4.0",
  "description": "Modular Discord Bot with Vertical Slice Architecture",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy:dev": "tsx src/core/scripts/deploy.ts --dev",
    "deploy:prod": "tsx src/core/scripts/deploy.ts --prod",
    "deploy:clear:dev": "tsx src/core/scripts/deploy.ts --clear-dev",
    "deploy:clear:global": "tsx src/core/scripts/deploy.ts --clear-global",
    "deploy:metadata": "tsx src/features/swarm-linked-roles/scripts/register-metadata.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@prisma/client": "^6.4.1",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/node-cron": "^3.0.11",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "schema": "src/shared/db/schema.prisma"
  }
}
